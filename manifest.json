{
  "manifest_version": 3,
  "name": "GroupRail - Side Tab Groups",
  "short_name": "GroupRail",
  "version": "1.0.2",
  "description": "A privacy-first Edge tab manager and tab groups sidebar that keeps loose tabs on top and compacts crowded group labels.",
  "homepage_url": "https://github.com/Fowlplaychiken/EdgeLeftsideGroupTabs",
  "minimum_chrome_version": "114",
  "permissions": [
    "contextMenus",
    "favicon",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Open GroupRail",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Open GroupRail"
    }
  }
}
